<?xml version="1.0" encoding="utf-8"?>
<!-- Chocolatey Package Manifest (lucidgrasp.nuspec) -->
<!-- The namespace must be one Chocolatey's NuGet fork recognises: its
     ManifestSchemaUtility accepts only schemas.microsoft.com/packaging
     2010/07, 2011/08, 2011/10, 2012/06, 2013/01, 2013/05 and 2015/06.
     Anything else, including the chocolatey.org/schema/chocolatey URL this
     manifest used to carry, makes choco pack abort with "The schema version
     of 'lucidgrasp' is incompatible with version ... of NuGet" and produce no
     .nupkg at all. 2013/05 is the newest one stock nuget.exe also knows, so
     the manifest stays packable either way. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>lucidgrasp</id>
    <version>1.2.3</version>
    <title>LucidGrasp</title>
    <authors>dialga-cmd</authors>
    <owners>dialga-cmd</owners>
    <description>High-performance image search engine built to identify and match visual media.</description>
    <summary>Image search engine based on SSIM, ORB and Color Histograms</summary>
    <tags>image-search opencv qt6</tags>
    <projectUrl>https://github.com/dialga-cmd/LucidGrasp</projectUrl>
    <projectSourceUrl>https://github.com/dialga-cmd/LucidGrasp</projectSourceUrl>
    <packageSourceUrl>https://github.com/dialga-cmd/LucidGrasp</packageSourceUrl>
    <bugTrackerUrl>https://github.com/dialga-cmd/LucidGrasp/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/dialga-cmd/LucidGrasp/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
  </metadata>
  <files>
    <!-- src/target, NOT source/destination: the nuspec schema declares only
         src (required), target and exclude, so the old attribute names made
         choco pack fail with "The 'source' attribute is not declared." -->
    <file src="LucidGrasp_Setup_x64.exe" target="installers" />
  </files>
</package>
